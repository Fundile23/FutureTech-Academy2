## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/

# Azure Keys - VERY IMPORTANT ⚠️
**/appsettings.json
**/appsettings.Development.json
**/secrets.json

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Visual Studio
.vs/
.vscode/
*.swp
*._py

# User Settings
.vs/
**/.vscode

# Backup files
*.bak
*.temp
*.tmp

# Git files
!.gitignore
!.gitattributes

# NuGet Packages
*.nupkg
packages/
*.nuget.props
*.nuget.targets

# dotnet core
**/wwwroot/lib/
**/node_modules/

# Published outputs
**/publish/
**/PublishScripts/

# JetBrains Rider
.idea/
*.sln.iml

# MacOS
.DS_Store