@{
    ViewData["Title"] = "Login";
}

<section class="hero-section">
    <div class="container">
        <div class="hero-content text-center" data-aos="fade-up">
            <div class="admin-badge d-inline-block">Secure Access</div>
            <h1>Admin Login</h1>
            <p class="text-muted">Sign in with your Google account to access the Student Management System</p>

            <div class="mt-5">
                <a asp-action="GoogleLogin" class="btn btn-primary-custom" style="padding: 14px 40px; font-size: 1.1rem;">
                    <i class="fab fa-google me-2"></i> Sign in with Google
                </a>
            </div>
        </div>
    </div>
</div>
