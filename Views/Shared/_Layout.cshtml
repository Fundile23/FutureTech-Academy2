<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FutureTech Academy</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --black: #000000;
            --white: #ffffff;
            --gray-dark: #1a1a1a;
            --gray-medium: #2c2c2c;
            --gray-light: #3a3a3a;
            --gray-lighter: #f5f5f5;
            --gray-text: #6b6b6b;
            --gray-border: #333333;
            --success-green: #28a745;
            --warning-orange: #fd7e14;
            --danger-red: #dc3545;
            --info-blue: #17a2b8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--white);
            color: var(--gray-text);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
            color: var(--black);
        }

        /* Navigation */
        .navbar {
            background-color: var(--white) !important;
            box-shadow: 0 2px 20px rgba(0,0,0,0.05);
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: var(--black) !important;
            font-size: 1.8rem;
        }

        .nav-link {
            color: var(--gray-medium) !important;
            font-weight: 500;
            margin: 0 15px;
            transition: color 0.3s ease;
        }

            .nav-link:hover {
                color: var(--black) !important;
            }

        /* Hero Section */
        .hero-section {
            padding: 40px 0 30px;
            background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
            position: relative;
            overflow: hidden;
            margin-bottom: 40px;
        }

            .hero-section::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -10%;
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, #e0e0e0 0%, transparent 70%);
                border-radius: 50%;
                opacity: 0.3;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-section h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .admin-badge {
            display: inline-block;
            padding: 4px 12px;
            background: var(--black);
            color: white;
            border-radius: 40px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 15px;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--white);
            border-radius: 24px;
            padding: 24px 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            border: 1px solid #e8e8e8;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
                border-color: var(--black);
            }

        .stat-icon {
            width: 50px;
            height: 50px;
            background: var(--gray-lighter);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

            .stat-icon i {
                font-size: 1.5rem;
                color: var(--black);
            }

        .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: var(--black);
            margin-bottom: 5px;
        }

        .stat-label {
            color: var(--gray-text);
            font-size: 0.85rem;
        }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .action-btn {
            background: var(--gray-lighter);
            border: 1px solid #e0e0e0;
            border-radius: 50px;
            padding: 12px 24px;
            text-decoration: none;
            color: var(--black);
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .action-btn:hover {
                background: var(--black);
                color: white;
                transform: translateY(-2px);
                border-color: var(--black);
            }

        /* Cards */
        .card-modern {
            background: var(--white);
            border-radius: 24px;
            border: 1px solid #e8e8e8;
            overflow: hidden;
            margin-bottom: 30px;
            transition: all 0.3s ease;
        }

            .card-modern:hover {
                box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            }

        .card-header-modern {
            background: var(--gray-lighter);
            padding: 20px 24px;
            border-bottom: 1px solid #e0e0e0;
        }

            .card-header-modern h5 {
                margin: 0;
                font-size: 1.1rem;
                font-weight: 600;
            }

        /* Tables */
        .table-custom {
            margin: 0;
        }

            .table-custom th {
                background: var(--white);
                color: var(--black);
                font-weight: 600;
                border-bottom: 1px solid #e8e8e8;
                padding: 15px 20px;
            }

            .table-custom td {
                padding: 15px 20px;
                vertical-align: middle;
                border-bottom: 1px solid #f0f0f0;
            }

            .table-custom tr:hover {
                background: var(--gray-lighter);
            }

        /* Buttons */
        .btn-primary-custom {
            background: var(--black);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 50px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-primary-custom:hover {
                background: var(--gray-medium);
                transform: translateY(-2px);
            }

        /* Status Badges */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        /* Footer */
        .footer {
            background-color: var(--black);
            color: var(--white);
            padding: 40px 0 30px;
            margin-top: 60px;
        }

            .footer a {
                color: #a0a0a0;
                text-decoration: none;
            }

                .footer a:hover {
                    color: var(--white);
                }

        /* Forms */
        .form-control, .form-select {
            border-radius: 12px;
            border: 1px solid #e0e0e0;
            padding: 12px 16px;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--black);
                box-shadow: none;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero-section h1 {
                font-size: 1.8rem;
            }

            .table-custom {
                font-size: 0.85rem;
            }

                .table-custom th, .table-custom td {
                    padding: 10px 12px;
                }
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">FutureTech Academy</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Students" asp-action="Index">
                            <i class="fas fa-users me-1"></i> Students
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="fas fa-lock me-1"></i> Privacy
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-1"></i> Logout
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="AdminManagement" asp-action="Index">
                <i class="fas fa-user-shield me-1"></i> Manage Admins
            </a>
        </li>
    </nav>

    <!-- Main Content -->
    <main role="main" style="margin-top: 80px;">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="text-center">
                <p>&copy; @DateTime.Now.Year FutureTech Academy. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>