{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Azure": {
    "CosmosDb": {
      "EndpointUri": "YOUR_COSMOS_URI_HERE",
      "PrimaryKey": "YOUR_COSMOS_KEY_HERE",
      "DatabaseName": "StudentDB",
      "ContainerName": "Students"
    },
    "BlobStorage": {
      "ConnectionString": "YOUR_BLOB_CONNECTION_STRING_HERE",
      "ContainerName": "student-images"
    }
  },

  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID_HERE",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET_HERE"
    }
  }
}